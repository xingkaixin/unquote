{
  "name": "@unquote/extension",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt --config wxt.dev.config.ts",
    "build": "wxt build",
    "build:safari": "wxt build -b safari -c wxt.safari.config.ts",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest run -c vitest.config.ts"
  },
  "dependencies": {
    "@unquote/ui": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "wxt": "^0.21.4"
  }
}
