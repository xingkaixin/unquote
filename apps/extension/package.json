{
  "name": "@unquote/extension",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt --config wxt.dev.config.ts",
    "build": "wxt build",
    "build:safari": "wxt build -b safari -c wxt.safari.config.ts",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "test": "vitest run -c vitest.config.ts"
  },
  "dependencies": {
    "@unquote/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wxt": "^0.21.4"
  }
}
