    "format:check": "oxfmt . --check",
    "test": "vitest run -c vitest.workspace.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@unquote/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.3"
  }
