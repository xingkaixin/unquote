{
  "name": "unquote",
  "version": "0.13.0",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @unquote/core build && vitest run --coverage",
    "check:background-budget": "node scripts/check-background-budget.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:background-budget",
    "benchmark": "turbo run build --force && node benchmark/perf-benchmark.mjs",
    "benchmark:case1": "pnpm build && node benchmark/case1-benchmark.mjs",
    "benchmark:fixtures": "node benchmark/generate-case2-fixtures.mjs",
    "benchmark:case4-fixture": "node benchmark/generate-case4-fixture.mjs",
    "deploy:cf": "pnpm --filter @unquote/web build && wrangler pages deploy dist/web --project-name=unquote",
    "zip-extension": "pnpm --filter @unquote/extension zip",
    "build:safari": "turbo run build:safari --filter=@unquote/extension && node scripts/sync-safari-extension.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
