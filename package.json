{
  "name": "unquote",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "test:coverage": "pnpm --filter @unquote/core build && vitest run --coverage",
    "check:background-budget": "node scripts/check-background-budget.mjs",
    "check:extension-manifest": "node scripts/check-extension-manifest.mjs",
    "check:ui-bundle-budget": "node scripts/check-ui-bundle-budget.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm check:ui-bundle-budget && pnpm check:background-budget && pnpm check:extension-manifest",
    "audit:high": "pnpm audit --audit-level high",
    "benchmark": "pnpm benchmark:fixtures && turbo run build --force && node benchmark/perf-benchmark.mjs",
    "benchmark:agent": "pnpm benchmark -- benchmark/case1-agent-session.jsonl benchmark/case1-agent-session-5K.jsonl",
    "benchmark:fixtures": "node benchmark/generate-fixtures.mjs",
    "benchmark:case4-fixture": "node benchmark/generate-case4-fixture.mjs",
    "deploy:cf": "pnpm --filter @unquote/web build && wrangler pages deploy dist/web --project-name=unquote",
    "zip-extension": "pnpm --filter @unquote/extension zip",
    "build:safari": "turbo run build:safari --filter=@unquote/extension && node scripts/sync-safari-extension.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
