{
  "name": "unquote",
  "version": "0.8.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "benchmark": "turbo run build --force && node benchmark/perf-benchmark.mjs",
    "benchmark:case1": "pnpm build && node benchmark/case1-benchmark.mjs",
    "benchmark:fixtures": "node benchmark/generate-case2-fixtures.mjs",
    "benchmark:case4-fixture": "node benchmark/generate-case4-fixture.mjs",
    "deploy:cf": "pnpm --filter @unquote/web build && wrangler pages deploy dist/web --project-name=unquote",
    "zip-extension": "pnpm --filter @unquote/extension zip"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.0.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.73.0",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.11.0"
}
